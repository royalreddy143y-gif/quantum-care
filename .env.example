# QuantumCare Configuration

# Application Environment (development, production)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# SQL Database Settings (SQLite / PostgreSQL)
# For PostgreSQL: postgresql://user:password@localhost:5432/quantumcare_db
# For Local SQLite (automatic fallback): sqlite:///./quantumcare.db
DATABASE_URL=sqlite:///./quantumcare.db

# MongoDB Atlas Cloud Database
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority&appName=QuantumCare
MONGODB_URI=mongodb+srv://royalreddy143y_db_user:YOUR_PASSWORD@quantumcare.ow7pwxn.mongodb.net/?retryWrites=true&w=majority&appName=QuantumCare
MONGODB_DB_NAME=quantumcare

# JWT Security
# WARNING: Change SECRET_KEY to a secure 32+ character random string in production!
SECRET_KEY=supersecretkey_change_in_production_min_32_bytes_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Seed Account Configuration
SEED_DEMO_DATA=true
DEMO_USER_EMAIL=demo@quantumcare.org
DEMO_USER_PASSWORD=QuantumCare2025!

# Model Execution Mode: 'demo' (deterministic simulation) or 'research' (live PyTorch/PennyLane forward pass)
MODEL_MODE=demo

# Storage & Upload Limits
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports
MAX_UPLOAD_SIZE=10485760

# Quantum Machine Learning Configuration
QUANTUM_NUM_QUBITS=4
QUANTUM_NUM_LAYERS=2

# CORS Allowed Origins (Comma-separated list or JSON array or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
