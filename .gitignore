# ==============================================================================
# Python Bytecode & Cache
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==============================================================================
# Virtual Environments & Packages
# ==============================================================================
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ==============================================================================
# Testing, Coverage & Linters
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.pytype/
.ruff_cache/

# ==============================================================================
# Node.js & Frontend Artifacts
# ==============================================================================
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
dist/
dist-ssr/
*.local
.vite/

# ==============================================================================
# Databases (Never commit runtime/test databases)
# ==============================================================================
*.db
*.db-journal
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
quantumcare.db
backend/quantumcare.db
test_*.db
backend/test_*.db

# ==============================================================================
# Environment & Secrets (Never commit credentials)
# ==============================================================================
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env
!frontend/.env.example

# ==============================================================================
# IDEs & Operating System Files
# ==============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
temp_chrome/
*.log

# ==============================================================================
# Runtime Uploads & Generated Reports (Preserve directory structure via .gitkeep)
# ==============================================================================
uploads/*
!uploads/.gitkeep
generated_reports/*
!generated_reports/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/generated_reports/*
!backend/generated_reports/.gitkeep

# ==============================================================================
# Large Binary Model Checkpoints & Circuit Artifacts
# ==============================================================================
ml_model/saved_models/*
!ml_model/saved_models/.gitkeep
quantum_ml/saved_circuits/*
!quantum_ml/saved_circuits/.gitkeep
